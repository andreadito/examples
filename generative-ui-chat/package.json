{
  "name": "generative-ui-chat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@json-render/core": "^0.19.0",
    "@json-render/jotai": "^0.19.0",
    "@json-render/react": "^0.19.0",
    "@json-render/xstate": "^0.19.0",
    "@mui/material": "^7.3.11",
    "@mui/x-charts": "^9.9.0",
    "@mui/x-chat": "^9.0.0-alpha.13",
    "@mui/x-data-grid": "^9.9.0",
    "@xstate/store": "^4.2.1",
    "ag-grid-community": "^36.0.0",
    "ag-grid-react": "^36.0.0",
    "cors": "^2.8.6",
    "echarts": "^6.1.0",
    "express": "^5.2.1",
    "jotai": "^2.20.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
